# Anchor gateway env-var template.
#
# USAGE
#   cp .env.example .env       # .env is .gitignore'd
#   edit .env with real values
#   source .env                # or use python-dotenv / your platform's secret store
#
# NEVER commit a populated .env to git. NEVER paste real keys in issues,
# chat, or shell history. The values below are illustrative placeholders
# only -- replace them with secrets fetched from your secret manager.
#
# This file is intentionally git-tracked: it documents the contract, not
# the values. See README.md -> "Security -> Token rotation procedure".

# ============================================================
# Anchor gateway auth tokens (REQUIRED in production)
# ------------------------------------------------------------
# Single env var, comma- or newline-separated list. Default quota per
# token: rpm=60, daily_tokens=0 (unlimited pure mode), scope=client. See
# src/anchor/secrets.py and README.md -> Security for the contract.
# ============================================================
ANCHOR_API_KEYS=sk-anchor-REPLACE-ME,sk-anchor-REPLACE-ME-2

# ============================================================
# Debug-only escape hatch (NEVER enable in production)
# ============================================================
# Skip auth entirely on non-admin paths. Only honoured when
# ANCHOR_PROFILE=debug. Both must be set.
ANCHOR_AUTH_DISABLED=0
ANCHOR_PROFILE=production

# ============================================================
# Upstream provider keys (env-only since Cat 1 PASS audit)
# ------------------------------------------------------------
# Each worker reads its own env var; see src/anchor/config.py for the
# canonical list. The categories below mirror the audit report.
# ============================================================

# --- CATEGORY 1a: OpenAI-compat providers (v0.9.50-p1: agnes/gemini/kilo/glm removed) ---

# OpenCode Zen (DeepSeek V4 Flash, multi-key failover)
OPENCODE_ZEN_API_KEY=sk-REPLACE-ME-OPENCODE
# Alias also accepted (OpenCode naming): OPENCODE_API_KEY=...
OPENCODE_ZEN_API_KEY_2=sk-REPLACE-ME-OPENCODE-2

# v0.9.62: dpsk-flash-official (DeepSeek paid API, slot 16)
# Default ON. Set ANCHOR_DISABLE_DEEPSEEK_V4_FLASH_OFFICIAL=1 to opt out.
# Required: DEEPSEEK_API_KEY from https://platform.deepseek.com
ANCHOR_DISABLE_DEEPSEEK_V4_FLASH_OFFICIAL=

# v0.9.63: Claude-group baosiapi key (separate from GPT-group key).
# claude-fable-5 / opus-5 / haiku-4-5 / sonnet-5 are auto-disabled at boot
# when this is unset (verified: GPT-group key returns 401 on claude-* models).
# To enable Claude workers: obtain a Claude-group baosiapi key and set:
# ANCHOR_BAOSIAPI_CLAUDE_API_KEY=sk-baosi-claude-...
# ANCHOR_BAOSIAPI_CLAUDE_API_KEY=

# DeepSeek official API (DeepSeek V4 Pro + v0.9.62 dpsk-flash-official shared quota).
# Gate-1 enable_gradual (placeholder 3.3% after thinking-disable fix).
# Opt-in M3 fallback: ANCHOR_ENABLE_DEEPSEEK_PRO=1
DEEPSEEK_API_KEY=sk-REPLACE-ME-DEEPSEEK

# --- CATEGORY 1b: MiniMax M3 (multi-key round-robin) ---
# Set at least one; the loader does client-level failover.
MINIMAX_API_KEY_1=sk-REPLACE-ME-M3-KEY1
MINIMAX_API_KEY_2=sk-REPLACE-ME-M3-KEY2
MINIMAX_API_KEY=sk-REPLACE-ME-M3-KEY3

# --- CATEGORY 1c: Baosi (unified host https://baosiapi.com/v1) ---
# Claude Fable/Sonnet/Opus/Haiku + GPT/Grok all use baosiapi.com (api.baosiapi.com retired).
# Prefer BAOSIAPI_GPT_API_KEY for everything on this host; BAOSIAPI_API_KEY is legacy optional.
BAOSIAPI_API_KEY=sk-REPLACE-ME-BAOSI-LEGACY-OPTIONAL

# --- CATEGORY 1d: Baosi GPT group (GPT-5.6 Sol, INDEPENDENT quota) ---
# Primary Baosi key (Claude Fable sacred + GPT Sol + Grok)
BAOSIAPI_GPT_API_KEY=sk-REPLACE-ME-BAOSI-GPT
# Alias also accepted (OpenCode naming): BAOSI_GPT_API_KEY=...

# Image-gen: Agnes API hub (image-gen endpoint only — chat Agnes removed v0.9.50-p1)
AGNES_API_KEY=sk-REPLACE-ME-AGNES-IMAGE

# ============================================================
# Operational knobs (optional, sensible defaults shown)
# ============================================================
# Routing
ANCHOR_CORS_ORIGINS=*
ANCHOR_MAX_FALLBACK_ATTEMPTS=4
ANCHOR_REQUIRE_AUTH=0

# Logging
ANCHOR_LOG_JSON=0

# Quota
ANCHOR_PROFILE=production

# ============================================================
# Production defaults (v0.9.53 lean pool) — see docs/PRODUCTION_ENV.md
# ============================================================
# Public product: model id `anchor` (+ `anchor-image`).
# Deny direct worker aliases in production (ops/debug may set 1).
# Local dev: set ANCHOR_LOOPBACK_TRUST=1 to skip auth for 127.0.0.1 clients.
ANCHOR_ALLOW_DIRECT_WORKER=0

# Readiness: key (default) | http (live upstream probe) | off
ANCHOR_READYZ_PROBE=chat
# Soft ready when no keys (debug only): ANCHOR_READYZ_SOFT=1

# Per-API-key RPM/daily quota backend:
#   memory  — single process
#   sqlite  — multi-worker same host (auto when WEB_CONCURRENCY>1)
#   redis   — multi-host (needs ANCHOR_REDIS_URL)
# Pure mode (default): local/self-use — no commercial billing stack.
# Per-query cost soft cap (¥). Hard-rule forced workers are never demoted.
# 0 = unlimited. Default 0.05 only affects non-forced (pareto) picks.
# ANCHOR_COST_BUDGET_CNY=0
# daily_tokens=0 means unlimited (only RPM soft-limit remains).
# ANCHOR_CLIENT_RPM=60
# ANCHOR_CLIENT_DAILY_TOKENS=0
# ANCHOR_ADMIN_RPM=60
# ANCHOR_ADMIN_DAILY_TOKENS=0
# To re-enable commercial-style caps when fronted by nothing:
# ANCHOR_CLIENT_DAILY_TOKENS=500000

ANCHOR_KEY_QUOTA_BACKEND=sqlite
# ANCHOR_KEY_QUOTA_DB=data/key_quota.db
# ANCHOR_REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=  # accepted as fallback alias of ANCHOR_REDIS_URL

# Sacred session spend guard (fable hard-cap path)
# ANCHOR_SACRED_BACKEND=sqlite   # or redis for multi-host
# ANCHOR_SACRED_DB=data/sacred.db
# ANCHOR_SACRED_REDIS_FAKE=0

# Opt-in workers (default OFF unless noted)
ANCHOR_ENABLE_DEEPSEEK_V4_FLASH=1   # free牛马; timeout 6s, no same-worker retry → M3
ANCHOR_ENABLE_DEEPSEEK_PRO=1   # recommended when DEEPSEEK_API_KEY set (M3 fallback)
# ANCHOR_ENABLE_SONNET=0
# ANCHOR_ENABLE_HAIKU=0
# ANCHOR_ENABLE_OPUS=1   # v0.9.54: default ON ($5/M, hard lane)
# ANCHOR_ENABLE_GROK4=0   # only after scripts/probe_grok.py recommends enable
# ANCHOR_ENABLE_LUNA=0
# ANCHOR_ENABLE_TERRA=0
# ANCHOR_ENABLE_K3=0
# FABLE5_TRAFFIC_PCT=100


# Grok mid-upper parallel race vs sol (default OFF — quality via sequential escalate)
# ANCHOR_GROK_RACE=1
# ANCHOR_WORKER_TIMEOUT_GROK_4_5_REASONING=6


# ============================================================
# Quarantine guard knobs (v0.9.55). Adjust only when false
# positives persist on a specific worker pool. The Wilson guard
# plus the per-prompt dedup already prevent retry-storm
# quarantines; these knobs are the lower-level safety net.
# ============================================================
# ANCHOR_QUARANTINE_MIN_N=20            # min observations before quarantine
# ANCHOR_QUARANTINE_MIN_SESSIONS=5      # min distinct session_ids
# ANCHOR_QUARANTINE_WILSON_Z=1.96       # z-score (95% CI)
# ANCHOR_QUARANTINE_RECHECK_INTERVAL_SEC=300  # PONG-probe cadence
